# Copy this file to .env and fill in your own values.
# .env is gitignored. Never put real secrets in this example file.

# Where the API listens
BASE_URL=http://localhost:5080

# The key the API requires in the X-Api-Key header
API_KEY=CHANGE_ME

# Database used by the scripts that reset and seed the data
DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=PositionsDb

# Leave both blank for Windows authentication (LocalDB).
# Set both to use SQL authentication, for example in the pipeline.
DB_USER=
DB_PASSWORD=

# Optional. Leave blank unless you need to override the connection string built
# from the four DB values above (for example a custom port or TrustServerCertificate).
# Only the API reads this one.
DB_CONNECTION_STRING=
