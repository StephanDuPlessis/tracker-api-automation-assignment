{
  "info": {
    "name": "Positions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helpers for every test script in this collection.",
          "// Postman scripts cannot import each other, so the code lives in one function,",
          "// its text is saved in a collection variable, and each test script loads it with eval().",
          "function buildHelpers() {",
          "    return {",
          "        // The response must have exactly this HTTP status code.",
          "        expectStatus(code) {",
          "            pm.test(`Status is ${code}`, () => {",
          "                pm.response.to.have.status(code);",
          "            });",
          "        },",
          "",
          "        // Every error response must be JSON of the form { \"error\": \"some text\" }.",
          "        expectError() {",
          "            pm.test('Body is { \"error\": \"...\" }', () => {",
          "                const body = pm.response.json();",
          "                pm.expect(body).to.have.property('error');",
          "                pm.expect(body.error).to.be.a('string').and.not.empty;",
          "            });",
          "        }",
          "    };",
          "}",
          "",
          "pm.collectionVariables.set('helpers', buildHelpers.toString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "helpers",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Auth",
      "item": [
        {
          "name": "Missing API key returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
                  "h.expectStatus(401);",
                  "h.expectError();"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/positions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "positions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Invalid API key returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
                  "h.expectStatus(401);",
                  "h.expectError();"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Api-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "wrong-key-123",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/positions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "positions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Valid API key returns 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
                  "h.expectStatus(200);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/positions?$top=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "positions"
              ],
              "query": [
                {
                  "key": "$top",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
