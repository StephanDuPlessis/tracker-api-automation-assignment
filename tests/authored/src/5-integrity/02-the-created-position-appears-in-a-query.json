{
  "name": "The created position appears in a query for its device",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(200);",
          "h.expectIds(['pos-test-int-001']);",
          "h.expectCount(1);"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions?$filter=deviceId eq 'TEST-I-50001'&$count=true",
      "host": ["{{baseUrl}}"],
      "path": ["positions"],
      "query": [
        { "key": "$filter", "value": "deviceId eq 'TEST-I-50001'" },
        { "key": "$count", "value": "true" }
      ]
    }
  },
  "response": []
}
