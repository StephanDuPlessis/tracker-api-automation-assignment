{
  "name": "$top=0 returns an empty list and no count",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(200);",
          "h.expectIds([]);",
          "h.expectNoCount();"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions?$filter=deviceId eq 'TEST-D-10001'&$top=0",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "positions"
      ],
      "query": [
        {
          "key": "$filter",
          "value": "deviceId eq 'TEST-D-10001'"
        },
        {
          "key": "$top",
          "value": "0"
        }
      ]
    }
  },
  "response": []
}
