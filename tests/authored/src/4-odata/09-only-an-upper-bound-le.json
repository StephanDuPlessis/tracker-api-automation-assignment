{
  "name": "Only an upper bound (le)",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(200);",
          "h.expectIds([",
          "    'pos-test-10001-01',",
          "    'pos-test-10002-01'",
          "]);",
          "h.expectCount(2);"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions?$filter=occurredAt le 2025-01-15T09:00:00Z&$orderby=occurredAt asc&$count=true",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "positions"
      ],
      "query": [
        {
          "key": "$filter",
          "value": "occurredAt le 2025-01-15T09:00:00Z"
        },
        {
          "key": "$orderby",
          "value": "occurredAt asc"
        },
        {
          "key": "$count",
          "value": "true"
        }
      ]
    }
  },
  "response": []
}
