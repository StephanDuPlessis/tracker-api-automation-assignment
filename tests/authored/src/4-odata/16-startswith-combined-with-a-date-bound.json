{
  "name": "startswith combined with a date bound",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(200);",
          "h.expectIds([",
          "    'pos-test-10001-01',",
          "    'pos-test-10002-01',",
          "    'pos-test-10001-02'",
          "]);"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions?$filter=startswith(deviceId,'TEST-D') and occurredAt le 2025-01-15T10:00:00Z&$orderby=occurredAt asc",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "positions"
      ],
      "query": [
        {
          "key": "$filter",
          "value": "startswith(deviceId,'TEST-D') and occurredAt le 2025-01-15T10:00:00Z"
        },
        {
          "key": "$orderby",
          "value": "occurredAt asc"
        }
      ]
    }
  },
  "response": []
}
