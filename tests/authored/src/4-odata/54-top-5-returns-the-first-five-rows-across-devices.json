{
  "name": "$top=5 returns the first five rows across devices",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(200);",
          "h.expectIds(['pos-test-10001-01', 'pos-test-10002-01', 'pos-test-10001-02', 'pos-test-10001-03', 'pos-test-10002-02']);"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions?$filter=startswith(deviceId,'TEST-D')&$orderby=occurredAt asc&$top=5",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "positions"
      ],
      "query": [
        {
          "key": "$filter",
          "value": "startswith(deviceId,'TEST-D')"
        },
        {
          "key": "$orderby",
          "value": "occurredAt asc"
        },
        {
          "key": "$top",
          "value": "5"
        }
      ]
    }
  },
  "response": []
}
