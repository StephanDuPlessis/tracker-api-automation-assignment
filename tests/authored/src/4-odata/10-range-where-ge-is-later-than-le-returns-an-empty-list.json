{
  "name": "Range where ge is later than le returns an empty list",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(200);",
          "h.expectIds([]);",
          "h.expectCount(0);"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions?$filter=occurredAt ge 2025-01-16T00:00:00Z and occurredAt le 2025-01-15T00:00:00Z&$count=true",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "positions"
      ],
      "query": [
        {
          "key": "$filter",
          "value": "occurredAt ge 2025-01-16T00:00:00Z and occurredAt le 2025-01-15T00:00:00Z"
        },
        {
          "key": "$count",
          "value": "true"
        }
      ]
    }
  },
  "response": []
}
