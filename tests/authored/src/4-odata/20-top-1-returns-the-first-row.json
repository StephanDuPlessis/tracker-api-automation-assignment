{
  "name": "$top=1 returns the first row",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(200);",
          "h.expectIds([",
          "    'pos-test-10001-01'",
          "]);"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions?$filter=deviceId eq 'TEST-D-10001'&$orderby=occurredAt asc&$top=1",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "positions"
      ],
      "query": [
        {
          "key": "$filter",
          "value": "deviceId eq 'TEST-D-10001'"
        },
        {
          "key": "$orderby",
          "value": "occurredAt asc"
        },
        {
          "key": "$top",
          "value": "1"
        }
      ]
    }
  },
  "response": []
}
