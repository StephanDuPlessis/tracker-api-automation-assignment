{
  "name": "Id of 101 characters returns 404 (not the 100-character id it starts with)",
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// The POST folder stored a 100-character id: 'pos-test-' + 91 letters a.",
          "// This id is that same id plus one more a. If the API cut long ids to 100 characters, it would wrongly find it.",
          "const h = eval('(' + pm.collectionVariables.get('helpers') + ')')();",
          "h.expectStatus(404);",
          "h.expectError();"
        ]
      }
    }
  ],
  "request": {
    "method": "GET",
    "header": [],
    "url": {
      "raw": "{{baseUrl}}/positions/pos-test-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "host": [
        "{{baseUrl}}"
      ],
      "path": [
        "positions",
        "pos-test-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ]
    }
  },
  "response": []
}
