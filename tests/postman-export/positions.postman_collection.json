  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Shared helpers for every test script in this collection.\r",
          "// Postman scripts cannot import each other, so the code lives in one function,\r",
          "// its text is saved in a collection variable, and each test script loads it with eval().\r",
          "function buildHelpers() {\r",
          "    return {\r",
          "        // The response must have exactly this HTTP status code.\r",
          "        expectStatus(code) {\r",
          "            pm.test(`Status is ${code}`, () => {\r",
          "                pm.response.to.have.status(code);\r",
          "            });\r",
          "        },\r",
          "\r",
          "        // Every error response must be JSON of the form { \"error\": \"some text\" }.\r",
          "        expectError() {\r",
          "            pm.test('Body is { \"error\": \"...\" }', () => {\r",
          "                const body = pm.response.json();\r",
          "                pm.expect(body).to.have.property('error');\r",
          "                pm.expect(body.error).to.be.a('string').and.not.empty;\r",
          "            });\r",
          "        }\r",
          "    };\r",
          "}\r",
          "\r",
          "pm.collectionVariables.set('helpers', buildHelpers.toString());\r",
          ""
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "helpers",
      "value": ""
